{
  "name": "vonza-ai-front-desk",
  "version": "1.0.0",
  "description": "Hungarian-first Website Agent SaaS for SME customer questions and lead capture.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "setup": "npm install",
    "start": "node index.js",
    "start:waitlist": "node waitlist-server.js",
    "start:prod": "npm run verify:deploy-readiness && node index.js",
    "dev": "node --watch index.js",
    "dev:waitlist": "node --watch waitlist-server.js",
    "lint": "eslint .",
    "test:smoke": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/*.test.js",
    "test:supabase": "node test-supabase.js",
    "desktop:install": "npm install --prefix apps/desktop",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:check": "npm --prefix apps/desktop run check",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:build:universal": "npm --prefix apps/desktop run build:mac:universal",
    "provision:calendly-webhook": "node scripts/provision-calendly-webhook.js",
    "check:schema-sync": "node scripts/check-schema-sync.js",
    "validate:clean-db": "node scripts/validate-clean-database.js",
    "verify:prod-schema": "node scripts/verify-prod-schema.js",
    "verify:deploy-readiness": "node scripts/verify-deploy-readiness.js",
    "eval:web-call": "node scripts/run-web-call-evals.js",
    "eval:front-desk": "node scripts/run-front-desk-evals.js",
    "eval:front-desk:json": "node scripts/run-front-desk-evals.js --json",
    "eval:hotel-concierge": "node scripts/run-hotel-concierge-evals.js",
    "eval:hotel-concierge:json": "node scripts/run-hotel-concierge-evals.js --json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.21.1",
    "openai": "^6.33.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "playwright": "^1.60.0"
  }
}
