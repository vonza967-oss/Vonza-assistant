PORT=3000
PUBLIC_APP_URL=http://localhost:3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

OPENAI_API_KEY=your_openai_api_key_here
FRONT_DESK_EVAL_MODE=dry-run
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDINGS_ENABLED=true
RAG_MAX_CONTEXT_CHUNKS=6
RAG_MIN_SIMILARITY=0.25
RAG_MAX_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=150
VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_MAX_AUDIO_BYTES=8388608
VOICE_MAX_AUDIO_DURATION_SECONDS=30
VOICE_TTS_MAX_CHARS=1200
ADMIN_TOKEN=your_admin_token_here

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/google/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_SECRET=replace_with_a_long_random_secret
BOOKING_WEBHOOK_ENCRYPTION_SECRET=replace_with_a_different_long_random_secret

STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PRICE_ID=your_stripe_price_id_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

VONZA_OPERATOR_WORKSPACE_V1=true
VONZA_TODAY_COPILOT_V1=true
DEV_FAKE_BILLING=false

# Launch hardening
# Use memory only for local development. Production should use redis/upstash.
RATE_LIMIT_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APP_TRUSTED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_IPS=
REQUIRE_PUBLIC_CHAT_TURNSTILE=false
TURNSTILE_SECRET_KEY=
